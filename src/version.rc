#include <windows.h>
#include "version.h"
1 VERSIONINFO
 FILEVERSION HIPPO_VERSION_NUMBERS
 PRODUCTVERSION HIPPO_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "agammann\0"
   VALUE "FileDescription", "Hungry Hippos tabletop game\0"
   VALUE "FileVersion", HIPPO_VERSION "\0"
   VALUE "InternalName", "HungryHippos\0"
   VALUE "LegalCopyright", "Copyright 2026 Alexander Ammann\0"
   VALUE "OriginalFilename", "HungryHippos.exe\0"
   VALUE "ProductName", "Hungry Hippos\0"
   VALUE "ProductVersion", HIPPO_VERSION "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
